# Classic Fitness Environment Variables Example

# Application Base URL
NEXT_PUBLIC_SITE_URL=https://classicfitnesshsr.com

# Business Contact Overrides (Optional - defaults to src/config/site.ts)
NEXT_PUBLIC_PHONE_NUMBER="+919876543210"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
NEXT_PUBLIC_CONTACT_EMAIL="contact@classicfitnesshsr.com"

# Analytics & Tracking (Optional)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID="XXXXXXXXXXXXXXX"

# Lead Destination Webhook / Notification (For Enquiry API route)
# Options: Webhook URL (Slack, Zapier, Make) or Email service
LEAD_WEBHOOK_URL="https://hooks.zapier.com/hooks/catch/XXXXXX/XXXXXX"
